# Backend Environment Configuration

# Server Host and Port
# Local Development: 127.0.0.1:8000
# Cloud Deployment (e.g. Render): host 0.0.0.0, dynamic PORT assigned by host
HOST=127.0.0.1
PORT=8000
# Render Web Service Startup Command:
# uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}

# Database Configuration
# Local SQLite default:
DUKAANVOICE_DB_URL=sqlite:///./dukaanvoice.db
# Cloud PostgreSQL / Neon Serverless (Example):
# DUKAANVOICE_DB_URL=postgresql://user:password@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Note: postgres:// schemes are automatically normalized to postgresql://

# Allowed CORS Origins (Comma-separated list for cloud frontends)
# Localhost dev and preview origins (5173, 3000, 4173) are allowed by default.
# Add your production frontend domain (e.g. Vercel deployment):
# CORS_ORIGINS=https://dukaanvoice.vercel.app,https://your-custom-domain.com

# Gnani Voice AI (Vachana Platform) Configuration
# Header Authentication: X-API-Key-ID: <GNANI_API_KEY>
GNANI_API_KEY=
# GNANI_STT_URL=https://api.vachana.ai/stt/v3
# GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
# GNANI_STT_MODEL=prisma-v3.0
# GNANI_TTS_MODEL=timbre-v3.0
# GNANI_TTS_VOICE=Shivani
# GNANI_TIMEOUT_SECONDS=10.0
